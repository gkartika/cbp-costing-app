{
  "name": "cbp-costing-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "migrate:up": "dotenv -e .env.local -- node-pg-migrate -j sql up",
    "migrate:down": "dotenv -e .env.local -- node-pg-migrate -j sql down",
    "migrate:create": "node-pg-migrate create -j sql --",
    "migrate:test:up": "dotenv -e .env.test -- node-pg-migrate -j sql up",
    "test": "npm run migrate:test:up && dotenv -e .env.test -- vitest run",
    "test:watch": "dotenv -e .env.test -- vitest",
    "seed:admin": "dotenv -e .env.local -- tsx scripts/seed-super-admin.ts",
    "seed:user": "dotenv -e .env.local -- tsx scripts/seed-user.ts",
    "seed:guide": "dotenv -e .env.local -- tsx scripts/seed-dev-guide.ts",
    "backup": "dotenv -e .env.local -- tsx scripts/backup-db.ts",
    "restore": "tsx scripts/restore-db.ts",
    "export:guide": "dotenv -e .env.local -- tsx scripts/export-guide.ts",
    "backtest:legacy": "dotenv -e .env.local -- tsx scripts/backtest-legacy.ts",
    "fill:price-gaps": "dotenv -e .env.local -- tsx scripts/fill-price-gaps.ts",
    "fill:washer-dimensions": "dotenv -e .env.local -- tsx scripts/fill-washer-dimensions.ts",
    "fill:washer-trading-sizes": "dotenv -e .env.local -- tsx scripts/fill-washer-trading-sizes.ts",
    "add:washer-f844-grade-rule": "dotenv -e .env.local -- tsx scripts/add-washer-f844-grade-rule.ts",
    "add:washer-f844-route-rule": "dotenv -e .env.local -- tsx scripts/add-washer-f844-route-rule.ts",
    "rename:nut-b8-trading-grades": "dotenv -e .env.local -- tsx scripts/rename-nut-b8-trading-grades.ts",
    "split:washer-profiles": "dotenv -e .env.local -- tsx scripts/split-washer-profiles.ts",
    "update:washer-raw-cut-formula": "dotenv -e .env.local -- tsx scripts/update-washer-raw-cut-formula.ts",
    "washer-dual-route-and-sus-grades": "dotenv -e .env.local -- tsx scripts/washer-dual-route-and-sus-grades.ts",
    "fix:zinc-coating": "dotenv -e .env.local -- tsx scripts/fix-zinc-coating.ts",
    "backfill:costing-customer-ids": "dotenv -e .env.local -- tsx scripts/backfill-costing-customer-ids.ts",
    "remove:unavailable-trading-nuts": "dotenv -e .env.local -- tsx scripts/remove-unavailable-trading-nuts.ts",
    "provision": "tsx scripts/provision.ts"
  },
  "dependencies": {
    "@types/pdfkit": "^0.17.6",
    "argon2": "^0.45.1",
    "exceljs": "^4.4.0",
    "next": "16.3.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.23.5",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
