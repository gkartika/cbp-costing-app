{
  "name": "cbp-costing-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "migrate:up": "dotenv -e .env.local -- node-pg-migrate -j sql up",
    "migrate:down": "dotenv -e .env.local -- node-pg-migrate -j sql down",
    "migrate:create": "node-pg-migrate create -j sql --",
    "migrate:test:up": "dotenv -e .env.test -- node-pg-migrate -j sql up",
    "test": "npm run migrate:test:up && dotenv -e .env.test -- vitest run",
    "test:watch": "dotenv -e .env.test -- vitest",
    "seed:admin": "dotenv -e .env.local -- tsx scripts/seed-super-admin.ts",
    "seed:guide": "dotenv -e .env.local -- tsx scripts/seed-dev-guide.ts",
    "backup": "dotenv -e .env.local -- tsx scripts/backup-db.ts",
    "restore": "tsx scripts/restore-db.ts"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "exceljs": "^4.4.0",
    "next": "16.3.0",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.23.5",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
